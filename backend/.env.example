APP_NAME=Progyantra API

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/progyantra
USE_NEON=false
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_SECRET=replace_with_secure_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Frontend origin
FRONTEND_ORIGIN=http://localhost:3000

# Gemini (Google API key)
GEMINI_API_KEY=replace_with_google_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.35
GEMINI_TIMEOUT_SECS=30

# Optional fallback LLM settings used by personality/skill test modules
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_SECS=30
